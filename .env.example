# Copy to .env for local development. Never commit .env.
PORT=8080

# Milestone 2: from the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Milestone 2: 32 random bytes, base64. Used to sign sessions and encrypt refresh tokens.
SESSION_KEY=
